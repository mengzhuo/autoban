# Alpine package definition.
# Build with scripts/build-apk.sh; it creates the source tarball, injects the
# checksum and runs abuild inside an Alpine container.
pkgname=autoban
pkgver=0.1.0
pkgrel=0
pkgdesc="Go implementation of fail2ban with nftables"
url="https://github.com/mengzhuo/autoban"
arch="x86_64 aarch64"
license="MIT"
maintainer="Meng Zhuo <mengzhuo@iscas.ac.cn>"
depends="nftables !fail2ban"
makedepends="go"
options="!check !strip"
install="$pkgname.pre-install $pkgname.post-install $pkgname.pre-deinstall"
source="$pkgname-$pkgver.tar.gz"

build() {
    cd "$srcdir/$pkgname-$pkgver"
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o autoban ./cmd/autoban
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o autoban-ctl ./cmd/autoban-ctl
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o autoban-regex ./cmd/autoban-regex
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 autoban "$pkgdir/usr/bin/autoban"
    install -Dm755 autoban-ctl "$pkgdir/usr/bin/autoban-ctl"
    install -Dm755 autoban-regex "$pkgdir/usr/bin/autoban-regex"

    install -Dm644 packaging/common/autoban.conf "$pkgdir/etc/autoban/autoban.conf"
    install -Dm644 packaging/common/jail.apk.local "$pkgdir/etc/autoban/jail.local"
    cp -r config/filter.d "$pkgdir/etc/autoban/"
    cp -r config/action.d "$pkgdir/etc/autoban/"
    install -Dm755 packaging/apk/autoban.initd "$pkgdir/etc/init.d/autoban"
}
