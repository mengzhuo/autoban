[Unit]
Description=autoban intrusion prevention daemon
Documentation=https://github.com/mengzhuo/autoban
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=autoban
Group=autoban
SupplementaryGroups=adm
ExecStart=/usr/bin/autoban -config /etc/autoban
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

ConfigurationDirectory=autoban
StateDirectory=autoban
StateDirectoryMode=0750
RuntimeDirectory=autoban
RuntimeDirectoryMode=0750
LogsDirectory=autoban
LogsDirectoryMode=0750

# nftables only needs CAP_NET_ADMIN; child nft processes inherit it.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
