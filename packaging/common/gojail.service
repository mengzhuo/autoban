[Unit]
Description=gojail intrusion prevention daemon
Documentation=https://github.com/mengzhuo/gojail
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=gojail
Group=gojail
SupplementaryGroups=adm
ExecStart=/usr/bin/gojail -config /etc/gojail
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

ConfigurationDirectory=gojail
StateDirectory=gojail
StateDirectoryMode=0750
RuntimeDirectory=gojail
RuntimeDirectoryMode=0750
LogsDirectory=gojail
LogsDirectoryMode=0750

# nftables only needs CAP_NET_ADMIN; child nft processes inherit it.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
