[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
maxretry = 5
findtime = 10m
bantime = 10m
backend = polling
usedns = warn
banaction = nftables
action_ = %(banaction)s[name=%(__name__)s]
action = %(action_)s

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 5
findtime = 10m
bantime = 10m

[caddy]
enabled = false
port = http,https
filter = caddy-auth
# Requires Caddy access logging to this file.
logpath = /var/log/caddy/access.log
maxretry = 5
findtime = 10m
bantime = 1h

[wordpress]
enabled = false
port = http,https
filter = wordpress
# Requires Caddy access logging to this file.
logpath = /var/log/caddy/access.log
maxretry = 5
findtime = 10m
bantime = 1h
