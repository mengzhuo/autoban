# Local overrides. This file enables a self-contained SSH demo.
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
maxretry = 3
findtime = 10m
bantime = 1h
banaction = dummy

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /tmp/gojail-demo/auth.log
maxretry = 3
findtime = 10m
bantime = 1h
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1d
action = dummy[name=%(__name__)s, logpath=/tmp/gojail/actions.log]

# Example of a second, complete but disabled jail. It can be started with
# `gj start nginx-http-auth` after its log file exists.
[nginx-http-auth]
enabled = false
filter = nginx-http-auth
logpath = /tmp/gojail-demo/nginx-error.log
maxretry = 5
findtime = 10m
bantime = 1h
action = dummy[name=%(__name__)s, logpath=/tmp/gojail/actions.log]
