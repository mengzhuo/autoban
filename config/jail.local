# Local overrides. This file enables a self-contained SSH demo.
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
maxretry = 3
findtime = 10m
bantime = 1h
banaction = dummy

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /tmp/autoban-demo/auth.log
maxretry = 3
findtime = 10m
bantime = 1h
bantime.increment = true
bantime.factor = 2
# Linear alternative: max(bancount * multiplier, bantime)
# bantime.multiplier = 10s
bantime.maxtime = 1d
action = dummy[name=%(__name__)s, logpath=/tmp/autoban/actions.log]

# Example of a second, complete but disabled jail. It can be started with
# `autoban-ctl start nginx-http-auth` after its log file exists.
[nginx-http-auth]
enabled = false
filter = nginx-http-auth
logpath = /tmp/autoban-demo/nginx-error.log
maxretry = 5
findtime = 10m
bantime = 1h
action = dummy[name=%(__name__)s, logpath=/tmp/autoban/actions.log]
