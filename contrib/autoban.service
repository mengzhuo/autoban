[Unit]
Description=autoban intrusion prevention daemon
Documentation=https://github.com/mengzhuo/autoban
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as an unprivileged, dedicated service user. Create it with
# contrib/autoban.sysusers or `useradd --system --user-group autoban`.
User=autoban
Group=autoban
# Debian/Ubuntu: /var/log/auth.log is readable by the adm group.
# Remove this line if your log files use different group/ACL permissions.
SupplementaryGroups=adm

ExecStart=/usr/local/bin/autoban -config /etc/autoban
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# systemd creates and owns these directories for User=autoban. They match the
# production paths in the configuration reference:
#   /etc/autoban, /var/lib/autoban, /run/autoban, /var/log/autoban
ConfigurationDirectory=autoban
StateDirectory=autoban
StateDirectoryMode=0750
RuntimeDirectory=autoban
RuntimeDirectoryMode=0750
LogsDirectory=autoban
LogsDirectoryMode=0750

# Firewall actions (iptables/nftables) need CAP_NET_ADMIN only. Ambient
# capabilities are inherited by child processes such as /bin/sh and nft.
# Add CAP_NET_RAW only if a custom action requires raw sockets.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Hardening. Relax only the options needed by a custom action.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
